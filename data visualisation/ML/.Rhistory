time_data <- read.table("/home/kweku/philemon/data visualisation/ML/secom/secom_labels.data", header = FALSE, sep = " ", quote = "\"")
#rename column headers
colnames(time_data) <- c("column 1","time")
# Convert the date-time column (predictor2) to POSIXct format
time_data$time <- as.POSIXct(time_data$time, format = "%d/%m/%Y %H:%M:%S")
# Merge row-wise
secom_df <- cbind(time_data$time, secom_data)
# View result
print(secom_data)
print(time_data)
print(secom_df)
rfNews()
